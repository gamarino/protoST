# protoST venv activate -- POSIX shells (sh, bash, zsh): `. bin/activate`
deactivate() {
    if [ -n "${_OLD_PATH+x}" ]; then PATH="$_OLD_PATH"; export PATH; unset _OLD_PATH; fi
    if [ -n "${_OLD_PS1+x}" ]; then PS1="$_OLD_PS1"; unset _OLD_PS1; fi
    unset STENV
    unset -f deactivate
}

# Activating twice must not stack the venv on PATH twice.
if [ -n "${_OLD_PATH+x}" ]; then deactivate; fi
_OLD_PATH="$PATH"
STENV="@VENV_PATH@"
PATH="$STENV/bin:$PATH"
export STENV PATH
if [ -n "${PS1+x}" ]; then
    _OLD_PS1="$PS1"
    PS1="(protoST) $PS1"
fi
