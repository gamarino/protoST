#!/usr/bin/env python3
# Sensor readings for demo 4: one JSON object per line, as a device gateway
# would send them. The temperature rises until the twin stops the pump.
import json
import time

temp = 60
for cycle in range(1, 7):
    temp += 4
    print(json.dumps({"cycle": cycle, "temp": temp, "flow": 12 * cycle}), flush=True)
    time.sleep(0.2)
