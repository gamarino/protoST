{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "protoST",
  "scopeName": "source.smalltalk",
  "patterns": [
    {
      "include": "#shebang"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "shebang": {
      "match": "\\A#!.*$",
      "name": "comment.line.shebang.smalltalk"
    },
    "expression": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#symbol"
        },
        {
          "include": "#literal-array"
        },
        {
          "include": "#character"
        },
        {
          "include": "#number"
        },
        {
          "include": "#method-definition"
        },
        {
          "include": "#block-params"
        },
        {
          "include": "#temporaries"
        },
        {
          "include": "#pseudo-variable"
        },
        {
          "include": "#class-name"
        },
        {
          "include": "#keyword-selector"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comment": {
      "begin": "\"",
      "end": "\"",
      "name": "comment.block.smalltalk"
    },
    "string": {
      "begin": "'",
      "end": "'(?!')",
      "name": "string.quoted.single.smalltalk",
      "patterns": [
        {
          "match": "''",
          "name": "constant.character.escape.smalltalk"
        }
      ]
    },
    "symbol": {
      "patterns": [
        {
          "begin": "#'",
          "end": "'(?!')",
          "name": "constant.other.symbol.smalltalk"
        },
        {
          "match": "#(?:[A-Za-z_][A-Za-z0-9_]*:)+(?:[A-Za-z_][A-Za-z0-9_]*)?",
          "name": "constant.other.symbol.smalltalk"
        },
        {
          "match": "#[A-Za-z_][A-Za-z0-9_]*",
          "name": "constant.other.symbol.smalltalk"
        },
        {
          "match": "#[-+*/\\\\<>=~@%&?!,|]+",
          "name": "constant.other.symbol.smalltalk"
        }
      ]
    },
    "literal-array": {
      "begin": "#\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.array.begin.smalltalk"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.array.end.smalltalk"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#string"
        },
        {
          "include": "#symbol"
        },
        {
          "include": "#character"
        },
        {
          "include": "#number"
        },
        {
          "include": "#literal-array-inner"
        },
        {
          "match": "\\b(?:true|false|nil)\\b",
          "name": "constant.language.smalltalk"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_:]*",
          "name": "constant.other.symbol.smalltalk"
        }
      ]
    },
    "literal-array-inner": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#literal-array"
        },
        {
          "include": "$self"
        }
      ]
    },
    "character": {
      "match": "\\$.",
      "name": "constant.character.smalltalk"
    },
    "number": {
      "patterns": [
        {
          "match": "-?\\b[0-9]+r[0-9A-Z]+(?:\\.[0-9A-Z]+)?(?:e-?[0-9]+)?\\b",
          "name": "constant.numeric.radix.smalltalk"
        },
        {
          "match": "-?\\b[0-9]+(?:\\.[0-9]+)?(?:[eds]-?[0-9]+)?\\b",
          "name": "constant.numeric.smalltalk"
        }
      ]
    },
    "method-definition": {
      "patterns": [
        {
          "match": "^\\s*([A-Z][A-Za-z0-9_]*)(\\s+class)?\\s*(>>)\\s*((?:[a-z_][A-Za-z0-9_]*:\\s*[a-z_][A-Za-z0-9_]*\\s*)+)",
          "captures": {
            "1": {
              "name": "entity.name.type.class.smalltalk"
            },
            "2": {
              "name": "storage.modifier.class.smalltalk"
            },
            "3": {
              "name": "keyword.operator.method-definition.smalltalk"
            },
            "4": {
              "patterns": [
                {
                  "match": "[a-z_][A-Za-z0-9_]*:",
                  "name": "entity.name.function.smalltalk"
                },
                {
                  "match": "[a-z_][A-Za-z0-9_]*",
                  "name": "variable.parameter.smalltalk"
                }
              ]
            }
          }
        },
        {
          "match": "^\\s*([A-Z][A-Za-z0-9_]*)(\\s+class)?\\s*(>>)\\s*([-+*/\\<>=~@%&?!,|]+)\\s*([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.type.class.smalltalk"
            },
            "2": {
              "name": "storage.modifier.class.smalltalk"
            },
            "3": {
              "name": "keyword.operator.method-definition.smalltalk"
            },
            "4": {
              "name": "entity.name.function.smalltalk"
            },
            "5": {
              "name": "variable.parameter.smalltalk"
            }
          }
        },
        {
          "match": "^\\s*([A-Z][A-Za-z0-9_]*)(\\s+class)?\\s*(>>)\\s*([a-z_][A-Za-z0-9_]*)\\b(?!:)",
          "captures": {
            "1": {
              "name": "entity.name.type.class.smalltalk"
            },
            "2": {
              "name": "storage.modifier.class.smalltalk"
            },
            "3": {
              "name": "keyword.operator.method-definition.smalltalk"
            },
            "4": {
              "name": "entity.name.function.smalltalk"
            }
          }
        }
      ]
    },
    "block-params": {
      "match": "(?<=\\[)\\s*((?::\\s*[A-Za-z_][A-Za-z0-9_]*\\s*)+)(\\|)",
      "captures": {
        "1": {
          "name": "variable.parameter.block.smalltalk"
        },
        "2": {
          "name": "punctuation.separator.block.smalltalk"
        }
      }
    },
    "temporaries": {
      "match": "(\\|)((?:\\s*[A-Za-z_][A-Za-z0-9_]*)+\\s*)(\\|)",
      "captures": {
        "1": {
          "name": "punctuation.definition.temporaries.smalltalk"
        },
        "2": {
          "name": "variable.other.temporary.smalltalk"
        },
        "3": {
          "name": "punctuation.definition.temporaries.smalltalk"
        }
      }
    },
    "pseudo-variable": {
      "patterns": [
        {
          "match": "\\b(?:self|super|thisContext)\\b",
          "name": "variable.language.smalltalk"
        },
        {
          "match": "\\b(?:true|false|nil)\\b",
          "name": "constant.language.smalltalk"
        }
      ]
    },
    "class-name": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.class.smalltalk"
    },
    "keyword-selector": {
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*:(?!=)",
      "name": "entity.name.function.keyword.smalltalk"
    },
    "operators": {
      "patterns": [
        {
          "match": ":=|_(?=\\s)",
          "name": "keyword.operator.assignment.smalltalk"
        },
        {
          "match": "\\^",
          "name": "keyword.control.return.smalltalk"
        },
        {
          "match": ">>",
          "name": "keyword.operator.method-definition.smalltalk"
        },
        {
          "match": "[-+*/\\\\<>=~@%&?!,|]+",
          "name": "keyword.operator.binary.smalltalk"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "\\.",
          "name": "punctuation.terminator.statement.smalltalk"
        },
        {
          "match": ";",
          "name": "punctuation.separator.cascade.smalltalk"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.definition.block.smalltalk"
        },
        {
          "match": "[{}]",
          "name": "punctuation.definition.brace-array.smalltalk"
        }
      ]
    }
  }
}
