{
  "name": "protost-debug",
  "displayName": "protoST",
  "description": "protoST (.st) language support: syntax highlighting and debugging via the protost --dap Debug Adapter Protocol adapter.",
  "version": "0.5.0",
  "publisher": "protost-placeholder",
  "engines": {
    "vscode": "^1.66.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onDebug",
    "onDebugResolve:protost",
    "onDebugDynamicConfigurations:protost",
    "onLanguage:smalltalk"
  ],
  "contributes": {
    "configuration": {
      "title": "protoST",
      "properties": {
        "protost.path": {
          "type": "string",
          "default": "",
          "description": "Path to the protost executable. Leave empty to resolve 'protost' from PATH."
        }
      }
    },
    "languages": [
      {
        "id": "smalltalk",
        "aliases": [
          "protoST",
          "Smalltalk"
        ],
        "extensions": [
          ".st"
        ],
        "configuration": "./language-configuration.json",
        "firstLine": "^#!.*\bprotost\b"
      }
    ],
    "breakpoints": [
      {
        "language": "smalltalk"
      }
    ],
    "debuggers": [
      {
        "type": "protost",
        "label": "protoST",
        "languages": [
          "smalltalk"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the protoST (.st) script to debug (the client's path when pathMappings is set).",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop once on entry before executing the first statement.",
                "default": false
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the program: where `Import from:` finds modules. Translated by pathMappings.",
                "default": "${fileDirname}"
              },
              "pathMappings": {
                "type": "array",
                "description": "Relate this machine's paths (localRoot) to the paths where protost runs (remoteRoot), for a remote or WSL session. Longest prefix wins; files under no mapping (such as the remote protoST library) are shown read-only, served by the adapter.",
                "items": {
                  "type": "object",
                  "required": [
                    "localRoot",
                    "remoteRoot"
                  ],
                  "properties": {
                    "localRoot": {
                      "type": "string",
                      "default": "${workspaceFolder}"
                    },
                    "remoteRoot": {
                      "type": "string"
                    }
                  }
                },
                "default": [
                  {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": ""
                  }
                ]
              },
              "remote": {
                "type": "object",
                "description": "Run the adapter on another machine: `command` is the argv prefix (ssh, wsl, docker exec ...), `path` the protost executable there. Requires pathMappings.",
                "required": [
                  "command"
                ],
                "properties": {
                  "command": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "For example [\"ssh\", \"-T\", \"-o\", \"BatchMode=yes\", \"user@host\"] or [\"wsl\", \"-d\", \"Ubuntu-24.04\", \"--\"]."
                  },
                  "path": {
                    "type": "string",
                    "description": "The protost executable on the remote side.",
                    "default": "protost"
                  }
                }
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "protost",
            "request": "launch",
            "name": "Debug current protoST script",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "protoST: Launch current script",
            "description": "Debug the active .st file with the protoST DAP adapter.",
            "body": {
              "type": "protost",
              "request": "launch",
              "name": "Debug current protoST script",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          },
          {
            "label": "protoST: Launch over SSH",
            "description": "Run protost --dap on a remote host over ssh; the workspace is mapped to the remote checkout.",
            "body": {
              "type": "protost",
              "request": "launch",
              "name": "protoST over SSH",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${fileDirname}\"",
              "remote": {
                "command": [
                  "ssh",
                  "-T",
                  "-o",
                  "BatchMode=yes",
                  "user@host"
                ],
                "path": "/home/user/.local/bin/protost"
              },
              "pathMappings": [
                {
                  "localRoot": "^\"\\${workspaceFolder}\"",
                  "remoteRoot": "/home/user/project"
                }
              ]
            }
          },
          {
            "label": "protoST: Launch in WSL",
            "description": "Run protost --dap inside a WSL distribution; the workspace is mapped to the Linux checkout.",
            "body": {
              "type": "protost",
              "request": "launch",
              "name": "protoST in WSL",
              "program": "^\"\\${file}\"",
              "cwd": "^\"\\${fileDirname}\"",
              "remote": {
                "command": [
                  "wsl",
                  "-d",
                  "Ubuntu-24.04",
                  "--"
                ],
                "path": "/home/user/.local/bin/protost"
              },
              "pathMappings": [
                {
                  "localRoot": "^\"\\${workspaceFolder}\"",
                  "remoteRoot": "/home/user/project"
                }
              ]
            }
          }
        ]
      }
    ],
    "grammars": [
      {
        "language": "smalltalk",
        "scopeName": "source.smalltalk",
        "path": "./syntaxes/smalltalk.tmLanguage.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gamarino/protoST"
  },
  "license": "MIT"
}
